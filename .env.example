# Скопируйте в .env (Docker) или .env.local (npm run dev/start) и заполните.

# ── Данные SStats ─────────────────────────────────────────────────────────────
# 1 = демо-режим без сети (синтетические матчи). На проде уберите или поставьте 0.
# design = то же, но часы стоят (всегда 4 октября, 19:30): один и тот же день во всех состояниях —
# для работы над виджетами, к API не обращается. Эмблемы команд для демо: npm run team-logos.
SSTATS_MOCK=0
# Только для демо: «перевести часы» синтетических матчей (увидеть live в любое время).
# SSTATS_MOCK_NOW=2026-10-02T19:30:00+03:00
# Ключ SStats (необязательно). Без ключа лимит — 30 запросов в минуту с одного IP.
# Ключ пишите только сюда (в .env / .env.local — они в .gitignore), не в код.
SSTATS_API_KEY=
# Наш потолок запросов в минуту (по умолчанию 25 без ключа, 60 с ключом).
# Если квота ключа выше — поднимите; на ответ 429 сайт сам притормозит.
# SSTATS_RPM=60
# SSTATS_API_URL=https://api.sstats.net

# ── Сайт ─────────────────────────────────────────────────────────────────────
SITE_URL=https://tag.bet
SITE_TIMEZONE=Europe/Moscow
SITE_TZ_LABEL=МСК
TELEGRAM_URL=
CONTACT_EMAIL=
YANDEX_METRIKA_ID=
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
# Порядок топ-турниров (ID лиг SStats). По умолчанию: ЛЧ, АПЛ, Ла Лига, Серия A, Бундеслига, Лига 1, РПЛ…
# FEATURED_LEAGUE_IDS=2,39,140,135,78,61,235,3,848

# ── Партнёрские ссылки букмекеров ────────────────────────────────────────────
# {subid} заменится на «место_матч» (например pick_1234567), {placement} и {match} — по отдельности.
# ERID и ADVERTISER — для маркировки рекламы, их выдаёт партнёрская программа.
AFF_FONBET_URL=
AFF_FONBET_ERID=
AFF_FONBET_ADVERTISER=
AFF_WINLINE_URL=
AFF_WINLINE_ERID=
AFF_WINLINE_ADVERTISER=
AFF_PARI_URL=
AFF_PARI_ERID=
AFF_PARI_ADVERTISER=
AFF_BETBOOM_URL=
AFF_BETBOOM_ERID=
AFF_BETBOOM_ADVERTISER=
AFF_LIGA_STAVOK_URL=
AFF_LIGA_STAVOK_ERID=
AFF_LIGA_STAVOK_ADVERTISER=
AFF_MARATHONBET_URL=
AFF_MARATHONBET_ERID=
AFF_MARATHONBET_ADVERTISER=
# Порядок партнёров; первый — главный (кнопка в шапке, sticky-плашка).
# PARTNERS_ORDER=fonbet,winline,pari,betboom,liga-stavok,marathonbet

# ── Служебное ────────────────────────────────────────────────────────────────
# Длинная случайная строка: открывает /admin?token=… и /api/debug/odds
ADMIN_TOKEN=
# Где хранить кэш ответов API и журнал кликов (в Docker смонтированы тома)
# CACHE_DIR=.cache/data
# DATA_DIR=.data
# Фоновый прогрев ближайших матчей топ-лиг
# WARMER=0
# WARMER_INTERVAL_MIN=15
# WARMER_MAX_MATCHES=60
